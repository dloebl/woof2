Fixes for memory-safety bugs (undefined behavior) in the reference
implementation, google/woff2 at fb9c337, applied by fuzz/build.rs to a copy
of fuzz/reference before compiling it. See fuzz/README.md.

--- a/src/normalize.cc
+++ b/src/normalize.cc
@@ -58,7 +58,12 @@
         (glyph_size > 0 && !ReadGlyph(glyph_data, glyph_size, &glyph))) {
       return FONT_COMPRESSION_FAILURE();
     }
-    size_t glyf_dst_size = glyf_table->buffer.size() - glyf_offset;
+    // FUZZ-REFERENCE-PATCH(1): Round4() of the previous glyph can move
+    // glyf_offset past the end of the buffer; the subtraction then wraps
+    // around and StoreGlyph() overflows the heap buffer. Saturate instead.
+    size_t glyf_dst_size = glyf_offset <= glyf_table->buffer.size()
+                               ? glyf_table->buffer.size() - glyf_offset
+                               : 0;
     if (!StoreGlyph(glyph, glyf_dst + glyf_offset, &glyf_dst_size)) {
       return FONT_COMPRESSION_FAILURE();
     }
@@ -157,6 +162,11 @@
     if (!WriteNormalizedLoca(index_fmt, num_glyphs, font)) {
       return FONT_COMPRESSION_FAILURE();
     }
+    // FUZZ-REFERENCE-PATCH(2): for a 'head' table reused from another font of
+    // a collection, buffer is empty and this writes out of bounds.
+    if (head_table->buffer.size() <= 51) {
+      return FONT_COMPRESSION_FAILURE();
+    }
     head_table->buffer[51] = 1;
   }
 
--- a/src/woff2_enc.cc
+++ b/src/woff2_enc.cc
@@ -267,8 +267,14 @@
       const Font::Table* table_to_store = font.FindTable(tag ^ 0x80808080);
       if (table_to_store == NULL) table_to_store = &original;
 
+      // FUZZ-REFERENCE-PATCH(3): for some malformed collections a reused
+      // table is stored here without being accounted for in
+      // total_transform_length, overflowing transform_buf.
+      if (transform_offset + table_to_store->length > transform_buf.size()) {
+        return FONT_COMPRESSION_FAILURE();
+      }
       StoreBytes(table_to_store->data, table_to_store->length,
-                 &transform_offset, &transform_buf[0]);
+                 &transform_offset, transform_buf.data());
     }
   }
 
